{
    "name": "silvershop/address-formats",
    "description": "Per-country address field rules for SilverShop: labels, required fields, postcode validation and formatting. Fixes per-country checkout and provides a reusable address formatter.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "silvershop", "address", "i18n", "checkout"],
    "authors": [
        {
            "name": "RVXD"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\AddressFormats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\AddressFormats\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "expose": [],
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
